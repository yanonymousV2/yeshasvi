---
import Base from '../layouts/Base.astro';
import '../styles/rail.css';
import { content as C, totalMs } from '../data/content';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const pad = (n: number) => String(n).padStart(2, '0');
const H = Object.fromEntries(C.hops.map((h, i) => [h.id, { ...h, n: pad(i) }]));
const STYLES = [
  ['paper', 'Paper', 'Warm, light and editorial', ['#f6f4ef', '#16171a', '#b03a08']],
  ['midnight', 'Midnight', 'The dark version of Paper', ['#0e0f11', '#ecebe7', '#ff7a45']],
  ['phosphor', 'Phosphor', 'Green CRT terminal with scanlines', ['#040704', '#a6ffa6', '#ffb000']],
  ['blueprint', 'Blueprint', 'Engineering drawing on grid paper', ['#0b3a8a', '#ffffff', '#ffd166']],
  ['brutalist', 'Brutalist', 'Hard borders, hard shadows', ['#f4f1e8', '#000000', '#ffe500']],
  ['swiss', 'Swiss', 'Strict grid, black, white and red', ['#ffffff', '#111111', '#d1000f']],
  ['neon', 'Neon', 'Navy with magenta and cyan glow', ['#09091c', '#ff5bdc', '#22d3ee']],
] as const;
const FONTS = [
  ['auto', 'Style default'], ['geist', 'Geist + Instrument Serif'], ['fraunces', 'Inter Tight + Fraunces'], ['plex', 'IBM Plex family'],
  ['grotesk', 'Space Grotesk + JetBrains'], ['newsreader', 'Manrope + Newsreader'], ['syne', 'Syne + DM Sans'],
];
const LAYOUTS = [
  ['Rail', '/', 'this page: vertical scroll'], ['Pipeline', '/designs/pipeline/', 'sideways, one hop per screen'],
  ['Trace', '/designs/trace/', 'a traceroute you expand'], ['Diagram', '/designs/diagram/', 'click components on a live diagram'],
  ['Bento', '/designs/bento/', 'everything at once, in tiles'], ['Motion', '/designs/motion/', 'cinematic scroll, kinetic type'],
];

// Pre-formatted blocks are built as strings so their whitespace survives exactly.
const digHtml = `<span class="c">$ dig yeshasvi</span>\n\n<span class="c">;; ANSWER SECTION:</span>\n` +
  C.dns.records.map(([t, v]) => `<span class="n">yeshasvi.</span>  <span class="c ttl">300 IN </span><span class="t">${t.padEnd(6)}</span> <span class="s">${esc(v)}</span>`).join('\n') +
  `\n\n<span class="c">;; Query time: ${C.hops[1].ms} msec</span>`;
const headersHtml = `<span class="rl"><b>GET</b> /yeshasvi <span class="k">HTTP/2</span></span>
<span class="k">host:</span>        <span class="v">yeshasvi</span>
<span class="k">accept:</span>      <span class="v">senior-backend-engineer</span>
<span class="k">user-agent:</span>  <span class="v hl" id="uaVal">your browser</span>
<span class="k">x-purpose:</span>   <span class="v">hiring · curiosity · collaboration</span>`;
const sqlStack = `<span class="kw">SELECT</span> category, tools <span class="kw">FROM</span> stack
<span class="kw">WHERE</span> used_in = <span class="str">'production'</span>
<span class="kw">ORDER BY</span> daily_use <span class="kw">DESC</span>;`;
const respHeaders = `<b>x-response-time:</b> <span id="respMs">${totalMs}</span> ms
<b>x-hops:</b> ${C.hops.length - 1}
<b>content-type:</b> application/human
<b>connection:</b> keep-alive
<b>cache-control:</b> no-store (come back)`;
const json = `{
  <span class="k">"email"</span>:    <a href="mailto:${C.email}">"${C.email}"</a>,
  <span class="k">"linkedin"</span>: <a href="${C.linkedin}" target="_blank" rel="noopener">"${C.linkedinLabel}"</a>,
  <span class="k">"github"</span>:   <a href="${C.github}" target="_blank" rel="noopener">"${C.githubLabel}"</a>,
  <span class="k">"blog"</span>:     <a href="${C.blog}">"${C.blog}"</a>,
  <span class="k">"phone"</span>:    <a href="tel:${C.phone}">"${C.phoneLabel}"</a>,
  <span class="k">"resume"</span>:   <a href="${C.resume}" target="_blank" rel="noopener">"Yeshasvi.pdf"</a>,
  <span class="k">"location"</span>: <span class="s">"${C.location}"</span>
}`;
const [core, desk, res] = C.services;
---
<Base title="Yeshasvi — Senior Backend Engineer" description="Yeshasvi is a senior backend engineer in Hyderabad who builds distributed systems in Go and Python. Scroll as an HTTP request through the stack he builds. AWS Certified Solutions Architect.">
  <a class="skip" href="#response">Skip to contact details</a>

  <header class="nav" id="nav">
    <div class="nav-in">
      <a href="#client" class="brand" aria-label="Yeshasvi, back to top">
        <img src={C.logo} alt="" width="26" height="26">
        {C.name} <small>{C.role}</small>
      </a>
      <a class="nav-link" href={C.blog}>blog</a>
      <a class="nav-skip" href="#response">skip to 200 OK →</a>
      <div class="style-wrap">
        <button class="icon-btn" id="styleBtn" type="button" aria-label="Change visual style" aria-haspopup="true" aria-expanded="false" aria-controls="styleMenu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a10 10 0 1 1 10-10c0 2.8-2.2 4-4 4h-2.2a1.8 1.8 0 0 0-1.3 3.1A1.6 1.6 0 0 1 12 22z"/><circle cx="7.5" cy="10.5" r="1.2"/><circle cx="11" cy="7" r="1.2"/><circle cx="16" cy="8.5" r="1.2"/></svg>
        </button>
        <div class="style-menu" id="styleMenu" role="radiogroup" aria-label="Visual style">
          <h4>Pick a style</h4>
          {STYLES.map(([k, n, d, cs]) => (
            <button class="style-opt" type="button" role="radio" aria-checked="false" data-style-opt={k}><span class="sw3">{cs.map((c) => <i style={`background:${c}`}></i>)}</span><span><b>{n}</b><small>{d}</small></span></button>
          ))}
          <h4>Font</h4>
          <div class="font-grid" role="radiogroup" aria-label="Font pairing">
            {FONTS.map(([k, n]) => <button class="font-opt" type="button" role="radio" aria-checked="false" data-font-opt={k}>{n}</button>)}
          </div>
          <h4>Layout</h4>
          <div class="layout-list">
            {LAYOUTS.map(([n, href, d]) => <a class:list={['layout-opt', { cur: href === '/' }]} href={href}><b>{n}</b><small>{d}</small></a>)}
          </div>
        </div>
      </div>
      <button class="icon-btn" id="themeToggle" type="button" aria-label="Toggle color theme">
        <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn btn-primary btn-sm" href={C.resume} target="_blank" rel="noopener">Résumé</a>
    </div>
  </header>

  <div class="hud" id="hud" aria-hidden="true">
    <span class="dot"></span><b id="hudLayer">client</b><span id="hudHop">hop 0/{C.hops.length - 1}</span><span class="hud-ms" id="hudMs">0 ms</span>
  </div>

  <div class="layout">
    <nav class="rail" aria-label="Request path">
      <div class="rail-line"><i class="rail-fill" id="railFill"></i></div>
      <ol id="railList">
        {C.hops.map((h) => <li><a href={`#${h.id}`}><span class="rn"></span><span class="rl">{h.name}<small>{h.sub}</small></span></a></li>)}
      </ol>
      <i class="rail-packet" id="railPacket"></i>
    </nav>

    <main>
      <!-- 00 CLIENT -->
      <section class="layer layer-hero" id="client" data-name="client" data-ms={H.client.ms}>
        <div class="who"><span><i class="live"></i>{C.name}</span><span>{C.role}</span><span>{C.location}</span></div>
        <h1 class="req"><span class="verb">GET</span> <span class="path">/yeshasvi<span class="caret" aria-hidden="true"></span></span></h1>
        <p class="hero-lede">Hi, <strong>you're the request.</strong> Scroll and I'll route you through a backend, the kind I build for a living, and introduce myself at every hop.</p>
        <pre class="req-headers" aria-label="Request headers" set:html={headersHtml}></pre>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#dns">
            Send request
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
          </a>
          <a class="btn btn-ghost" href="#response">Skip to 200 OK</a>
        </div>
      </section>

      <!-- 01 DNS -->
      <section class="layer" id="dns" data-name={H.dns.name} data-ms={H.dns.ms}>
        <div class="hop-tag"><b>hop {H.dns.n}</b> dns <span class="lat">+{H.dns.ms} ms</span></div>
        <h2 set:html={H.dns.title} />
        <div class="dns-grid">
          <div class="dig-wrap reveal" id="digWrap">
            <pre class="dig card" set:html={digHtml}></pre>
            <a class="stamp" href={C.credly} target="_blank" rel="noopener" aria-label="AWS Certified Solutions Architect – Associate. Verify on Credly">
              <img src={C.badge} alt="" width="116" height="116">
              <span class="stamp-tip">Verify on Credly ↗</span>
            </a>
          </div>
          <div class="dns-text reveal">
            {C.dns.text.map((p) => <p set:html={p} />)}
          </div>
        </div>
      </section>

      <!-- 02 LOAD BALANCER -->
      <section class="layer" id="lb" data-name={H.lb.name} data-ms={H.lb.ms}>
        <div class="hop-tag"><b>hop {H.lb.n}</b> load balancer <span class="lat">+{H.lb.ms} ms</span></div>
        <h2 set:html={H.lb.title} />
        <p class="layer-sub">{C.lb.sub}</p>
        <div class="lb reveal" id="lbBox">
          <div class="lb-head">lb · round robin</div>
          <svg class="lb-wires" viewBox="0 0 300 56" preserveAspectRatio="none" aria-hidden="true">
            <path d="M150,0 C150,28 50,28 50,56"/><path d="M150,0 L150,56"/><path d="M150,0 C150,28 250,28 250,56"/>
          </svg>
          <div class="nodes">
            {C.lb.nodes.map((n) => (
              <article class="node card"><span class="you" aria-hidden="true">← you are here</span>
                <div class="node-top"><span>{n.id}</span><span class="hc"><i></i>healthy</span></div>
                <h3>{n.title}</h3>
                <p>{n.text}</p>
                <div class="tags">{n.tags.map((t) => <span class="tag">{t}</span>)}</div>
              </article>
            ))}
          </div>
          <div class="lb-foot">{C.lb.foot.map(([k, v]) => <span>{k}: <b>{v}</b></span>)}</div>
        </div>
      </section>

      <!-- 03 WAF -->
      <section class="layer" id="waf" data-name={H.waf.name} data-ms={H.waf.ms}>
        <div class="hop-tag"><b>hop {H.waf.n}</b> waf <span class="lat">+{H.waf.ms} ms</span></div>
        <h2 set:html={H.waf.title} />
        <p class="layer-sub" set:html={C.waf.sub} />
        <div class="waf card reveal" id="wafBox">
          <div class="waf-req">
            <code id="wafReq"><span class="verb">GET</span> /yeshasvi</code>
            <div class="waf-btns">
              <button class="btn btn-ghost btn-sm" type="button" id="wafSqli">Try SQL injection</button>
              <button class="btn btn-ghost btn-sm" type="button" id="wafFlood">Flood it</button>
            </div>
          </div>
          <ol class="rules">
            {C.waf.rules.map((r) => <li class="rule" data-rule={r.key}><span class="st">✓</span><code>{r.code}</code><p>{r.text}</p><span class="verdict">pending</span></li>)}
          </ol>
          <div class="waf-res" id="wafRes" aria-live="polite"><span class="code">…</span><span>evaluating rules</span></div>
        </div>
      </section>

      <!-- 04 GATEWAY -->
      <section class="layer" id="gateway" data-name={H.gateway.name} data-ms={H.gateway.ms}>
        <div class="hop-tag"><b>hop {H.gateway.n}</b> gateway <span class="lat">+{H.gateway.ms} ms</span></div>
        <h2 set:html={H.gateway.title} />
        <p class="layer-sub">{C.routesSub}</p>
        <div class="routes card reveal">
          <div class="routes-head"><span>route</span><span class="h-arr"></span><span>upstream</span><span class="h-when" style="text-align:right">active</span></div>
          {C.routes.map((r) => <div class="route-row"><span class="path">{r.path}</span><span class="arr">→</span><span class="role">{r.role}<small set:html={r.where} /></span><span class="when">{r.when}</span></div>)}
          <div class="routes-foot"><a href={C.resume} target="_blank" rel="noopener">full history in résumé.pdf ↗</a></div>
        </div>
      </section>

      <!-- 05 SERVICES -->
      <section class="layer" id="services" data-name={H.services.name} data-ms={H.services.ms}>
        <div class="hop-tag"><b>hop {H.services.n}</b> services <span class="lat">+{H.services.ms} ms</span></div>
        <h2 set:html={H.services.title} />
        <p class="layer-sub">Three worth opening. Two of them you can poke at.</p>

        <div class="svc-tabs" role="tablist" aria-label="Services">
          <button class="svc-tab" role="tab" id="t-core" aria-controls="p-core" aria-selected="true"><i></i>{core.tab}</button>
          <button class="svc-tab" role="tab" id="t-desk" aria-controls="p-desk" aria-selected="false" tabindex="-1"><i></i>{desk.tab}</button>
          <button class="svc-tab" role="tab" id="t-res" aria-controls="p-res" aria-selected="false" tabindex="-1"><i></i>{res.tab}</button>
        </div>

        <div class="svc-panel card reveal" role="tabpanel" id="p-core" aria-labelledby="t-core">
          <div>
            <span class="badge">{core.badge}</span>
            <h3>{core.title}</h3>
            <p>{core.text}</p>
            <div class="chips3">{core.chips!.map(([b, s]) => <div><b>{b}</b><span>{s}</span></div>)}</div>
            <p class="lab-try"><b>Try this:</b> {core.tryThis}</p>
          </div>
          <div class="lab-widget">
            <div class="ctrls">
              <label class="ctrl"><span>Service hops <output id="gHopsOut">4</output></span><input type="range" id="gHops" min="1" max="8" value="4"></label>
              <label class="ctrl"><span>Payload <output id="gSizeOut">32 KB</output></span><input type="range" id="gSize" min="0" max="5" value="2"></label>
              <label class="ctrl"><span>Round trip <output id="gRttOut">2 ms</output></span><input type="range" id="gRtt" min="0" max="5" value="2"></label>
              <label class="toggle"><input type="checkbox" id="gKeep"><span class="toggle-ui"></span>REST keep-alive</label>
            </div>
            <div class="lanes">
              <div class="lane">
                <div class="lane-head"><b>REST</b><span>JSON · HTTP/1.1</span><output id="gRestMs" class="lane-ms">0 ms</output></div>
                <div class="track"><div class="segs" id="gRestSegs"></div><i class="runner" id="gRestRun"></i></div>
              </div>
              <div class="lane">
                <div class="lane-head"><b>gRPC</b><span>protobuf · HTTP/2</span><output id="gGrpcMs" class="lane-ms">0 ms</output></div>
                <div class="track"><div class="segs" id="gGrpcSegs"></div><i class="runner" id="gGrpcRun"></i></div>
              </div>
            </div>
            <div class="lab-foot">
              <div class="legend-row"><span><i class="sw sw-conn"></i>connection setup</span><span><i class="sw sw-net"></i>network</span><span><i class="sw sw-ser"></i>serialization</span></div>
              <button class="btn btn-ghost btn-sm" id="gRace" type="button">Race ▶</button>
            </div>
            <p class="lab-verdict" id="gVerdict" aria-live="polite"></p>
            <p class="lab-note">A simplified model, not production data. Assumes a 1 Gbps link, JSON about 2.5× the size of protobuf, and a TCP + TLS handshake of 3 round trips when connections aren't reused.</p>
          </div>
        </div>

        <div class="svc-panel card" role="tabpanel" id="p-desk" aria-labelledby="t-desk" hidden>
          <div>
            <span class="badge">{desk.badge}</span>
            <h3>{desk.title}</h3>
            <p>{desk.text}</p>
            <div class="chips3">{desk.chips!.map(([b, s]) => <div><b>{b}</b><span>{s}</span></div>)}</div>
            <div class="tags">{desk.tags!.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
          <dl class="case">
            {desk.caseRows!.map(([dt, dd]) => <div><dt>{dt}</dt><dd set:html={dd} /></div>)}
          </dl>
        </div>

        <div class="svc-panel card" role="tabpanel" id="p-res" aria-labelledby="t-res" hidden>
          <div>
            <span class="badge">{res.badge}</span>
            <h3>{res.title}</h3>
            <p>{res.text}</p>
            <p class="lab-try"><b>Try this:</b> {res.tryThis}</p>
          </div>
          <div class="lab-widget">
            <div class="ctrls-row">
              <div class="seg-ctrl" role="radiogroup" aria-label="Failure strategy">
                <button type="button" role="radio" aria-checked="false" data-mode="retry">Retries only</button>
                <button type="button" role="radio" aria-checked="true" data-mode="breaker">Circuit breaker</button>
              </div>
              <button class="btn btn-primary btn-sm" id="cbBreak" type="button">Break downstream</button>
            </div>
            <svg class="cb-svg" viewBox="0 0 520 150" aria-hidden="true">
              <path class="sys-wire" id="cb-w1" d="M96,75 L192,75"/>
              <path class="sys-wire" id="cb-w2" d="M328,75 L424,75"/>
              <g id="cbPackets"></g>
              <g class="sys-node"><rect x="8" y="50" width="88" height="50" rx="10"/><text x="52" y="80" text-anchor="middle">client</text></g>
              <g class="sys-node cb-breaker" id="cbNode"><rect x="192" y="44" width="136" height="62" rx="10"/><text x="260" y="70" text-anchor="middle" id="cbTitle">breaker</text><text class="sub" x="260" y="88" text-anchor="middle" id="cbState">closed</text></g>
              <g class="sys-node" id="cbDown"><rect x="424" y="50" width="88" height="50" rx="10"/><text x="468" y="73" text-anchor="middle">service</text><text class="sub" x="468" y="89" text-anchor="middle" id="cbDownState">healthy</text></g>
            </svg>
            <div class="cb-stats">
              <div><span>Load on downstream</span><b id="cbLoad">0 calls/s</b></div>
              <div><span>Average user wait</span><b id="cbWait">—</b></div>
              <div><span>Answered with fallback</span><b id="cbFast">0</b></div>
            </div>
            <p class="lab-note">Each call times out after 900 ms. Retries try 3 times with backoff. The breaker opens after 3 failures in a row, then sends one test request after 3 seconds.</p>
          </div>
        </div>

        <div class="also reveal"><span>also running:</span>{C.alsoRunning.map((t) => <span class="tag">{t}</span>)}</div>
      </section>

      <!-- 06 QUEUE -->
      <section class="layer" id="queue" data-name={H.queue.name} data-ms={H.queue.ms}>
        <div class="hop-tag"><b>hop {H.queue.n}</b> queue <span class="lat">+0 ms · async</span></div>
        <h2 set:html={H.queue.title} />
        <p class="layer-sub">Side projects, research and writing. They run in the background, so they don't add a millisecond to your request.</p>
        <div class="queue">
          <article class="msg msg-sage card reveal">
            <div class="msg-meta"><b>offset 0</b>open source</div>
            <div class="msg-body">
              <div>
                <span class="badge">Go · CLI</span>
                <h3>{C.sage.title}</h3>
                <p>{C.sage.text}</p>
                <div class="install">
                  <code id="sageInstall">{C.sage.install}</code>
                  <button class="copy-mini" id="sageCopy" type="button">copy</button>
                </div>
                <a class="ext" href={C.sage.repo} target="_blank" rel="noopener">View on GitHub ↗</a>
              </div>
              <div class="lab-widget">
                <div class="chips sage-chips" role="tablist" aria-label="Example questions">
                  <button type="button" role="tab" class="chip" data-q="0" aria-selected="true">why is my disk full</button>
                  <button type="button" role="tab" class="chip" data-q="1" aria-selected="false">what's using port 3000</button>
                  <button type="button" role="tab" class="chip" data-q="2" aria-selected="false">is postgres running</button>
                </div>
                <div class="term-win">
                  <div class="term-bar"><i></i><i></i><i></i><span>~ — zsh</span></div>
                  <pre class="term-body" id="sageTerm" aria-live="polite"></pre>
                </div>
                <p class="lab-note">A replay with sample output. When you run it, sage answers from your own machine's data.</p>
              </div>
            </div>
          </article>
          <div class="papers">
            {C.papers.map((p, i) => (
              <article class="msg card reveal">
                <div class="msg-meta"><b>offset {i + 1}</b>research</div>
                <div class="msg-body">
                  <span class="badge">{p.badge}</span>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                  <a class="ext" href={p.link} target="_blank" rel="noopener">{p.linkLabel}</a>
                </div>
              </article>
            ))}
          </div>
          <article class="msg card reveal">
            <div class="msg-meta"><b>offset 3</b>writing</div>
            <div class="msg-body">
              <span class="badge">blog</span>
              <h3>Notes on backend systems</h3>
              <p>Write-ups on the systems I build and the trade-offs behind them.</p>
              <a class="ext" href={C.blog}>Read the blog →</a>
            </div>
          </article>
        </div>
      </section>

      <!-- 07 DATABASE -->
      <section class="layer" id="db" data-name={H.db.name} data-ms={H.db.ms}>
        <div class="hop-tag"><b>hop {H.db.n}</b> database <span class="lat">+{H.db.ms} ms</span></div>
        <h2 set:html={H.db.title} />
        <p class="layer-sub">Indexed for fast lookups.</p>
        <div class="db card reveal">
          <pre class="sql" set:html={sqlStack}></pre>
          <table class="result">
            <thead><tr><th>category</th><th>tools</th></tr></thead>
            <tbody>
              {C.stack.map(([k, tools]) => <tr><td>{k}</td><td><div class="tags">{(tools as string[]).map((t) => <span class="tag">{t}</span>)}</div></td></tr>)}
            </tbody>
          </table>
          <div class="rows">{C.stack.length} rows in set (0.007 sec)</div>
        </div>
        <div class="db card reveal">
          <pre class="sql"><span class="kw">SELECT</span> * <span class="kw">FROM</span> certifications;</pre>
          <table class="result">
            <tbody>
              <tr><td>aws</td><td>
                <div class="cert">
                  <img src={C.badge} alt="" width="44" height="44">
                  <div><b>{C.cert.title}</b><span>{C.cert.meta} · </span><a class="verify" href={C.credly} target="_blank" rel="noopener">verify on Credly ↗</a></div>
                </div>
              </td></tr>
            </tbody>
          </table>
          <div class="rows">1 row in set (0.001 sec)</div>
        </div>
      </section>

      <!-- 08 RESPONSE -->
      <section class="layer" id="response" data-name={H.response.name} data-ms={H.response.ms}>
        <div class="hop-tag"><b>hop {H.response.n}</b> response <span class="lat">+{H.response.ms} ms</span></div>
        <div class="resp reveal">
          <div class="status-line"><span>HTTP/2</span><span class="ok">200 OK</span></div>
          <h2 set:html={H.response.title} />
          <div class="resp-grid">
            <pre class="resp-headers" set:html={respHeaders}></pre>
            <div>
              <pre class="json" set:html={json}></pre>
              <div class="resp-actions">
                <a class="btn" href={`mailto:${C.email}`}>Email me</a>
                <button class="btn ghost" id="copyEmail" type="button">Copy email</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <footer>
    <div class="in">
      <span>© <span id="year">2026</span> {C.name} · {C.location}</span>
      <span><a href={C.blog}>blog</a> · <a href="/rss.xml">rss</a> · connection: keep-alive</span>
    </div>
  </footer>

  <script is:inline src="/js/rail.js"></script>
</Base>
