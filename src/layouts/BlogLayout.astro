---
// Shell for blog pages: shared head, design kit tokens and the site nav.
import Base from './Base.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/blog.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
}
const { title, description, type } = Astro.props;
---
<Base title={title} description={description} type={type}>
  <Fragment slot="head">
    <link rel="stylesheet" href={url('/kit/kit.css')}>
  </Fragment>
  <SiteNav current="blog" />
  <div class="b-wrap">
    <slot />
  </div>
</Base>
